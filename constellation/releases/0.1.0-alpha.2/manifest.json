        "bounded-source-acquisition",
        "saved-sqlite-check-and-maintenance-projection",
        "durable-finite-recurrence",
        "retained-attention-and-exact-replay",
        "local-notification-custody"
      ],
      "required_components": [
        "monitor",
        "nq",
        "nightshift"
      ],
      "optional_components": [],
      "synthetic_capabilities": [],
      "example_inputs": "Caller-created disposable SQLite queue with 20 rows and an explicit temporary maintenance declaration. Real component commands and actual source reads; no substituted service or reviewer.",
      "writer_requirement": "One operator-owned local tutorial root. The enrolled relationship between Monitor observation and NQ SQLite target is an operator assertion, not an atomic cross-process snapshot.",
