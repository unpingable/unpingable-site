  "profiles": [
    {
      "id": "objective-saved-check-read/v1",
      "use_case": "Author a local objective and inspect one exact saved-check result with separate outcome, freshness and maintenance states.",
      "required_capabilities": [
        "authored-plan-and-criterion-identity",
        "bounded-source-acquisition",
        "saved-sqlite-check-and-maintenance-projection",
        "durable-finite-recurrence",
        "retained-attention-and-local-inbox-custody",
        "explicit-application-criterion-mapping",
        "read-only-objective-assembly"
      ],
      "required_components": [
        "maude",
        "monitor",
        "nq",
        "nightshift",
        "ag",
        "phosphor"
      ],
      "optional_components": [],
      "optional_inputs": [
        "Existing AG campaign and Docket attempt histories may be inspected by the wider interface, but are not supplied or qualified by this profile."
      ],
      "synthetic_capabilities": [],
      "example_inputs": "Caller-created disposable SQLite queue, explicit maintenance declaration, synthetic_agent submitter metadata and empty real campaign directory. Actual component calls, not substituted services. Application enrolls one criterion mapping and prerequisite assertion.",
      "writer_requirement": "One operator-owned local root; exact program pathnames, plan and enrollment remain quiescent. Source-to-SQLite relationship and prerequisite coverage are caller assertions, not atomic cross-owner facts.",
      "limitations": [
        "The saved check intentionally fails; expired evidence changes the assessment to indeterminate, not the retained outcome.",
        "The unmapped criterion remains unknown; no objective-completion, health, permission or causal inference is supplied.",
        "No AG authorization, Docket effect, Standing grant, independent reviewer or model provider participates.",
        "Local-file delivery does not prove human receipt or acknowledgment.",
        "Finite attended recipe; no installed recurring service or supervisor-loss recovery guarantee.",
        "Read-only inspection is supported; restoration, migration, rollback and retention rollover are not qualified.",
        "Full application migration, governed-action B/C recipes, ECAD/design-flow and federation are outside this profile."
      ]
    }
  ],
