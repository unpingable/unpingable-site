# /etc/nightshift/observation-cycle.env  (systemd EnvironmentFile: KEY=VALUE, no quotes/export)
# Posture-only: no AG, no continuity, no substrate-origin flags.
# Generated files live under /var/lib/nightshift (the unit has ProtectSystem=strict; /etc is read-only).
NIGHTSHIFT_STORE=/var/lib/nightshift/nightshift.sqlite
NIGHTSHIFT_CYCLE_REQUEST=/var/lib/nightshift/cycles/current.json
NIGHTSHIFT_NQ_PROGRAM=/usr/bin/nq
NIGHTSHIFT_NQ_CONFIG=/etc/nq/nq.toml
# = producer.node_id of the artifact = the `nq-store-genesis:<uuid>` minted by `nq init` on THIS VM.
# build_request.py refuses to run if it differs from the artifact (nq_admission.rs:97,716).
NIGHTSHIFT_NQ_SOURCE_ID=nq-store-genesis:REPLACE_WITH_THIS_VMS_GENESIS_ID
NIGHTSHIFT_PRESENT_EVIDENCE_RESOLVER=/usr/bin/pulse-support-resolver
# Not a nightshift flag: the resolver child inherits nightshift's environment (pulse main.rs:63).
PULSE_LOAD_SUPPORT_CONFIG=/var/lib/nightshift/cycles/pulse-load-support.json
# Used only by ExecStartPre (site variables)
SITE_NQ_DB=/var/lib/nq/nq.db
SITE_NQ_INSTANCE=fs-data-capacity
SITE_EPOCH=2026-10-01T00:00:00Z
SITE_CADENCE=300
SITE_ADMISSIBLE=150
NIGHTSHIFT_CONTINUITY_FLAGS=
NIGHTSHIFT_SUBSTRATE_ORIGIN_FLAGS=
NIGHTSHIFT_AG_FLAGS=
