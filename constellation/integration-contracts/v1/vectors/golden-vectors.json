    {"id": "observer-authorized-binding-ready-credential", "mutations": [{"pointer": "/operations/1/purpose", "value": "Invoke the synthetic root observer as root/Operations"}, {"pointer": "/operations/1/credentialRequirements/0/purpose", "value": "sudo-root-observer"}, {"pointer": "/credentials/0/purpose", "value": "sudo-root-observer"}], "expected": {"operation": "effect", "disposition": "permitted-by-declared-contract", "absentBlockerCodes": ["INVOCATION_BINDING_MISSING", "INVOCATION_PRINCIPAL_UNAUTHORIZED", "CREDENTIAL_NOT_PRESENT"]}},
