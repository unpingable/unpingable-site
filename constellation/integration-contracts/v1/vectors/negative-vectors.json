    {"id": "non-rfc3339-week-date", "special": "preflight with ISO week date", "errorCode": "ASSESSMENT_TIME_INVALID"},
    {"id": "invalid-rfc3339-offset-minute", "special": "preflight with +00:60 offset", "errorCode": "ASSESSMENT_TIME_INVALID"},
    {"id": "invalid-rfc3339-offset-hour", "special": "preflight with +24:00 offset", "errorCode": "ASSESSMENT_TIME_INVALID"},
    {"id": "unknown-rfc3339-negative-zero-offset", "special": "preflight with -00:00 unknown offset", "errorCode": "ASSESSMENT_TIME_INVALID"},
    {"id": "accepted-receipt-template-basis", "mutations": [{"pointer": "/receipts/0/evidenceBasisStatus", "value": "template"}], "errorCode": "RECEIPT_ACCEPTANCE_INCOMPLETE"},
