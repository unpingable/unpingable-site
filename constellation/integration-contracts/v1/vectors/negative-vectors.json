    {"id": "production-authority-for-external-effect", "mutations": [{"pointer": "/operations/2/kind", "value": "external-effect"}], "errorCode": "OPERATION_AUTHORITY_KIND"},
    {"id": "credential-authority-not-required-by-operation", "mutations": [{"pointer": "/operations/1/credentialRequirements/0/requiredAuthorityRef", "value": "local-work"}, {"pointer": "/credentials/0/authorityGrantedRefs", "value": ["local-work"]}], "errorCode": "CREDENTIAL_AUTHORITY_NOT_REQUIRED"},
