    {"id": "q2-path-missing-issuer-authority", "mutations": [{"pointer": "/receipts/0", "value": {"id": "accepted-record", "schemaType": "fixture.accepted/v1", "issuerOwnerRef": "issuer", "evidenceBasis": "deterministic fixture evidence", "evidenceBasisStatus": "recorded", "artifactIdentity": "fixture:///Q2/acceptance.json", "artifactIdentityStatus": "recorded", "custody": "fixture vector", "custodyStatus": "recorded", "retention": "retain with vector", "downstreamConsumers": ["effect", "produce"], "disposition": "externally-accepted"}}], "errorCode": "FIELD_MISSING"},
    {"id": "q2-path-missing-custody", "mutations": [{"pointer": "/receipts/0", "value": {"id": "accepted-record", "schemaType": "fixture.accepted/v1", "issuerOwnerRef": "issuer", "issuerAuthorityRef": "issuer-acceptance", "evidenceBasis": "deterministic fixture evidence", "evidenceBasisStatus": "recorded", "artifactIdentity": "fixture:///Q2/acceptance.json", "artifactIdentityStatus": "recorded", "custodyStatus": "recorded", "retention": "retain with vector", "downstreamConsumers": ["effect", "produce"], "disposition": "externally-accepted"}}], "errorCode": "FIELD_MISSING"},
    {"id": "q2-path-missing-custody-status", "mutations": [{"pointer": "/receipts/0", "value": {"id": "accepted-record", "schemaType": "fixture.accepted/v1", "issuerOwnerRef": "issuer", "issuerAuthorityRef": "issuer-acceptance", "evidenceBasis": "deterministic fixture evidence", "evidenceBasisStatus": "recorded", "artifactIdentity": "fixture:///Q2/acceptance.json", "artifactIdentityStatus": "recorded", "custody": "fixture vector", "retention": "retain with vector", "downstreamConsumers": ["effect", "produce"], "disposition": "externally-accepted"}}], "errorCode": "FIELD_MISSING"},
    {"id": "q2-path-missing-positive-scope", "mutations": [{"pointer": "/receipts/0", "value": {"id": "accepted-record", "schemaType": "fixture.accepted/v1", "issuerOwnerRef": "issuer", "issuerAuthorityRef": "issuer-acceptance", "evidenceBasis": "deterministic fixture evidence", "evidenceBasisStatus": "recorded", "artifactIdentity": "fixture:///Q2/acceptance.json", "artifactIdentityStatus": "recorded", "custody": "fixture vector", "custodyStatus": "recorded", "retention": "retain with vector", "disposition": "externally-accepted"}}], "errorCode": "FIELD_MISSING"},
    {"id": "q2-gate-missing-negative-scope", "mutations": [{"pointer": "/gates/0", "value": {"id": "Q2", "kind": "required-evidence", "ownerRef": "issuer", "status": "satisfied", "recordedDisposition": "legacy fixture record is recorded externally accepted", "requiredReceiptRefs": ["accepted-record"], "blocks": ["effect", "produce"], "timeBoundary": null}}], "errorCode": "FIELD_MISSING"},
    {"id": "q2-gate-incomplete-negative-scope", "mutations": [{"pointer": "/gates/0/doesNotBlock", "value": ["prepare"]}], "errorCode": "GATE_SCOPE_INCOMPLETE"},
    {"id": "runtime-operation-missing-execution-class", "mutations": [{"pointer": "/operations/1", "value": {"id": "effect", "kind": "local-effect", "invocationBinding": {"principalRef": "root", "authorityRef": "local-effect"}, "purpose": "apply fixture effect", "consumer": "worker", "credentialRequirements": [{"credentialRef": "worker-credential", "purpose": "fixture-compute", "consumer": "worker", "requiredAuthorityRef": "local-effect"}], "requiredReceiptRefs": ["accepted-record"], "producedReceiptRefs": ["effect-result"], "requiredAuthorityRefs": ["local-effect"], "requiredResourceRuleRefs": [], "requiredPrivacyRuleRefs": []}}], "errorCode": "FIELD_MISSING"},
    {"id": "source-only-runtime-kind", "mutations": [{"pointer": "/operations/1/executionClass", "value": "source-only"}, {"pointer": "/operations/1/invocationBinding", "value": null}], "errorCode": "EXECUTION_CLASS_KIND_MISMATCH"},
    {"id": "source-only-declares-runtime-binding", "mutations": [{"pointer": "/operations/0/invocationBinding", "value": {"principalRef": "root", "authorityRef": "local-work"}}], "errorCode": "SOURCE_ONLY_INVOCATION_BINDING"},
    {"id": "invocation-principal-dangling", "mutations": [{"pointer": "/operations/1/invocationBinding/principalRef", "value": "absent"}], "errorCode": "REFERENCE_DANGLING"},
    {"id": "invocation-authority-not-required", "mutations": [{"pointer": "/operations/3/invocationBinding/authorityRef", "value": "local-effect"}], "errorCode": "INVOCATION_AUTHORITY_NOT_REQUIRED"},
    {"id": "authority-missing-principal-allowlist", "mutations": [{"pointer": "/authorities/0", "value": {"id": "local-work", "ownerRef": "root", "kind": "local-work", "boundary": "bounded local work", "status": "established", "evidenceRefs": []}}], "errorCode": "FIELD_MISSING"},
    {"id": "credential-missing-principal-allowlist", "mutations": [{"pointer": "/credentials/0", "value": {"id": "worker-credential", "purpose": "fixture-compute", "readiness": "present", "scopeVerification": "verified", "authorizedConsumers": ["worker"], "authorityGrantedRefs": ["local-effect"], "authorityNotGrantedRefs": ["production-effect"], "evidenceRefs": ["accepted-record"], "sourceRefs": ["policy"]}}], "errorCode": "FIELD_MISSING"}
