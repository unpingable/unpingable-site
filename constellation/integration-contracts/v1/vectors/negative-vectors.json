  "cases": [
    {"id": "unknown-version", "mutations": [{"pointer": "/apiVersion", "value": "constellation.integration/v2"}], "errorCode": "VERSION_UNKNOWN"},
    {"id": "boolean-as-number", "mutations": [{"pointer": "/resourceRules/0/minimum", "value": true}], "errorCode": "TYPE_NUMBER"},
    {"id": "duplicate-id", "mutations": [{"pointer": "/operations/1/id", "value": "prepare"}], "errorCode": "DUPLICATE_ID"},
