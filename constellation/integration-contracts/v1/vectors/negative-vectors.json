    {"id": "privacy-with-nonprivacy-authority", "mutations": [{"pointer": "/privacyEgress/0/requiredAuthorityRefs", "value": ["local-effect"]}], "errorCode": "PRIVACY_AUTHORITY_KIND"},
    {"id": "credential-consumer-differs-from-operation", "mutations": [{"pointer": "/operations/1/credentialRequirements/0/consumer", "value": "operator"}, {"pointer": "/credentials/0/authorizedConsumers", "value": ["worker", "operator"]}], "errorCode": "CREDENTIAL_CONSUMER_MISMATCH"},
