    {"id": "accepted-receipt-missing-artifact-identity", "mutations": [{"pointer": "/receipts/0/artifactIdentityStatus", "value": "missing"}], "errorCode": "RECEIPT_ACCEPTANCE_INCOMPLETE"},
    {"id": "accepted-receipt-missing-custody", "mutations": [{"pointer": "/receipts/0/custodyStatus", "value": "missing"}], "errorCode": "RECEIPT_ACCEPTANCE_INCOMPLETE"},
